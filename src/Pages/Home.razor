@page "/"
@inject IJSRuntime JsRuntime

<main class="container">
    <section class="hero">
        <p class="eyebrow">Tauri + Blazor</p>
        <h1>Welcome to your app</h1>
        <p class="intro">A fast desktop experience powered by Rust and .NET.</p>

        <div class="row logos" aria-label="Technology logos">
            <a href="https://tauri.app" target="_blank" rel="noreferrer">
                <img src="img/tauri.svg" class="logo tauri" alt="Tauri logo" />
            </a>
            <a href="https://dotnet.microsoft.com/en-us/apps/aspnet/web-apps/blazor" target="_blank" rel="noreferrer">
                <img src="img/blazor.svg" class="logo blazor" alt="Blazor logo" />
            </a>
        </div>

        <div class="greeting-form">
            <label for="greet-input">Your name</label>
            <input id="greet-input" @bind="GreetInput" placeholder="Jane Doe" />
            <button type="button" @onclick="GreetAsync">Greet me</button>
        </div>

        <br>

        <div class="counter">
            <button type="button" @onclick="CounterAsync">@(Count == 0 ? "Count" : Count.ToString())</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(GreetMsg))
        {
            <p class="message" role="status">@GreetMsg</p>
        }
    </section>
</main>

@code
{
    private string? GreetInput { get; set; }

    private string? GreetMsg { get; set; }

    private int Count { get; set; } = 0;

    private async Task CounterAsync()
    {
        var result = await JsRuntime.InvokeAsync<string>(
        "__TAURI__.core.invoke",
        "counter",
        new { counter = Count.ToString() });

        if (int.TryParse(result, out var parsed))
        {
            Count = parsed;
        }
    }

    private async Task GreetAsync()
    {
        GreetMsg = await JsRuntime.InvokeAsync<string>("__TAURI__.core.invoke", "greet", new { name = GreetInput });
    }
}
